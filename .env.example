OPENAI_API_KEY=
CONFIDENT_API_KEY=key

HONO_BASE_URL=http://127.0.0.1:8787
HONO_CHAT_PATH=/v1/ai/chat
HONO_TOKEN=token-jwt
HONO_TIMEOUT=60

DEEPEVAL_JUDGE_MODEL=openai/gpt-4o-mini
DEEPEVAL_JUDGE_BASE_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/smart-deepeval/compat/chat/completions
DEEPEVAL_JUDGE_TIMEOUT=120
DEEPEVAL_THRESHOLD=0.7
DEEPEVAL_INCLUDE_REASON=true

CF_AIG_TOKEN=
CF_AIG_BYOK_ALIAS=

CONFIDENT_AI_ENABLED=false
CONFIDENT_AI_RUN_IDENTIFIER=smart-deepeval
CONFIDENT_AI_SEND_HYPERPARAMETERS=true
CONFIDENT_AI_PROJECT=SMART API
CONFIDENT_AI_ENVIRONMENT=local

SMART_AVAILABLE_TOOLS=smart_soil_data,smart_rain_accumulated,smart_rain_forecast,smart_radiation_solar,smart_lightning_incidence,smart_lightning_strikes,smart_lightning_risk,smart_wind_speed,smart_wind_direction,smart_wind_gust,smart_wind_current_weather,smart_wind_forecast,smart_air_temperature,smart_air_humidity,smart_air_pressure,smart_air_conditions,smart_air_current_weather
