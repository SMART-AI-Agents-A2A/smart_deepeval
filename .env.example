# ---- Juiz DeepEval (DigitalOcean Serverless Inference) ----
DEEPEVAL_JUDGE_MODEL=deepseek-v4-pro
DEEPEVAL_JUDGE_BASE_URL=https://inference.do-ai.run/v1
DEEPEVAL_JUDGE_TIMEOUT=800
DEEPEVAL_JUDGE_MAX_TOKENS=500
DEEPEVAL_JUDGE_RESPONSE_FORMAT=false
DEEPEVAL_JUDGE_RETRY_ATTEMPTS=6
DEEPEVAL_JUDGE_RETRY_BASE_SLEEP=2
DEEPEVAL_JUDGE_RETRY_MAX_SLEEP=90
DEEPEVAL_JUDGE_TOTAL_DEADLINE=540

# Chaves aceitas (ordem: MODEL_ACCESS_KEY > DIGITALOCEAN_TOKEN > OPENAI_API_KEY > OPEN_API_KEY)
MODEL_ACCESS_KEY=
# DIGITALOCEAN_TOKEN=
# OPENAI_API_KEY=
# OPEN_API_KEY=

# ---- DeepEval geral ----
DEEPEVAL_THRESHOLD=0.7
DEEPEVAL_INCLUDE_REASON=true
DEEPEVAL_MAX_CONCURRENT=1
DEEPEVAL_TOOL_SELECTION_WITH_LLM=false

# Orcamento de tempo do DeepEval por tarefa (segundos), inclui retries.
# Mantenha MAIOR que DEEPEVAL_JUDGE_TOTAL_DEADLINE para o juiz parar antes do DeepEval cancelar.
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=600
# 0 = desativa o timeout por tentativa interno do DeepEval (usa so o orcamento por tarefa)
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=0
DEEPEVAL_TASK_GATHER_BUFFER_SECONDS_OVERRIDE=15

# ---- Debug ----
DEEPEVAL_DEBUG_PAYLOAD=false
DEEPEVAL_DEBUG_PREVIEW_CHARS=800
DEEPEVAL_DEBUG_JSON=outputs/deepeval_debug.json

# ---- API SMART (Hono) ----
HONO_BASE_URL=http://127.0.0.1:8787
HONO_CHAT_PATH=/v1/ai/chat
HONO_ORIGIN=http://localhost:5173
HONO_TIMEOUT=60
HONO_TOKEN=
HONO_COOKIE=
HONO_RETRY_ATTEMPTS=4
HONO_RETRY_BASE_SLEEP=2
HONO_RETRY_MAX_SLEEP=60

# ---- Confident AI (opcional) ----
CONFIDENT_AI_ENABLED=false
# CONFIDENT_API_KEY=
CONFIDENT_AI_RUN_IDENTIFIER=smart-deepeval
CONFIDENT_AI_SEND_HYPERPARAMETERS=true
CONFIDENT_AI_PROJECT=SMART API
CONFIDENT_AI_ENVIRONMENT=local